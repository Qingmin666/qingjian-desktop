  {
    "name": "qingjian_list_tasks",
    "title": "qingjian_list_tasks",
    "description": "List tasks with optional filters and offset pagination.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "done": {
          "type": "boolean"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "maxLength": 500
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "qingjian_get_task",
    "title": "qingjian_get_task",
    "description": "Read one task and its children.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "qingjian_add_task",
    "title": "qingjian_add_task",
    "description": "Create a root task or one-level child; missing date defaults to the local date.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "date": {
          "type": "string",
          "maxLength": 10
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "dueAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "ISO 8601 timestamp with explicit Z or UTC offset; null clears it."
        },
        "remindAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "ISO 8601 timestamp with explicit Z or UTC offset; null clears it."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique UUID for this mutation; reuse the identical request on retry."
        },
        "expectedRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Revision returned by info/list/get; stale revisions are rejected."
        }
      },
      "required": [
        "title",
        "requestId",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
